  "trip_coverage": {
   "pooled_as": "ratio of sums",
   "definition": "observed trips over scheduled trips"
  },
  "timepoint_coverage": {
   "pooled_as": "ratio of sums",
   "definition": "timepoint events with a time over scheduled timepoint events"
  },
  "vehicle_uptime": {
   "pooled_as": "ratio of sums",
   "definition": "20-second fetch slots that worked over slots due (time-weighted)"
  },
  "off_shape_share": {
   "pooled_as": "ratio of sums",
   "definition": "positions more than 100 m off the route over positions tracked"
  },
  "feed_agreement_share": {
   "pooled_as": "ratio of sums",
   "definition": "departures that agree with the feed's stop sequence over those compared"
  },
  "impossible_jumps": {
   "pooled_as": "sum",
   "definition": "consecutive positions implying more than 130 km/h"
  },
  "glitch_reports_removed": {
   "pooled_as": "sum",
   "definition": "positions left out as GPS glitches"
  },
  "position_age_s_p95": {
   "pooled_as": "median of daily values",
   "definition": "95th percentile of position age, seconds"
  },
  "untimed_gap": {
   "pooled_as": "ratio of sums",
   "definition": "timepoint departures with no time because the feed went quiet, over scheduled ones"
  },
  "untimed_skipped": {
   "pooled_as": "ratio of sums",
   "definition": "timepoint departures with no time because the bus left out that part of the route, over scheduled ones"
  },
  "untimed_not_reached": {
   "pooled_as": "ratio of sums",
   "definition": "timepoint departures with no time because the bus stopped reporting before it got there, over scheduled ones"
  },
  "untimed_no_reports": {
   "pooled_as": "ratio of sums",
   "definition": "timepoint departures with no time because the trip sent nothing, over scheduled ones"
  },
  "untimed_past_when_first_seen": {
   "pooled_as": "ratio of sums",
   "definition": "timepoint departures with no time because the bus was already past when it first reported, over scheduled ones"
  }
 },
